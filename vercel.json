{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": { "includeFiles": ["prisma/**"] }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "build": {
    "env": {
      "DATABASE_URL": "@database-url"
    }
  },
  "env": {
    "DATABASE_URL": "@database-url"
  }
}