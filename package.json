{
  "name": "kawaii-planner",
  "version": "1.0.0",
  "description": "Kawaii themed productivity application with task management, notes, and calendar",
  "main": "server.js",
  "scripts": {
    "build": "prisma generate && prisma migrate deploy",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "vercel-build": "npm install -g prisma && prisma generate && prisma migrate deploy",
    "postinstall": "npm install -g prisma && prisma generate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.3.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "nodemon": "^3.0.1",
    "prisma": "^5.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
